#!/bin/bash

set -euo pipefail

variables=(QT_QPA_PLATFORMTHEME QT_QPA_PLATFORMTHEME_QT6 XDG_MENU_PREFIX)
state_dir=${XDG_RUNTIME_DIR:?}/dux-niri
state_file=$state_dir/environment.before

restore_environment() (
  [[ -f "$state_file" ]] || exit 0
  unset "${variables[@]}"
  # systemctl emits shell-escaped assignments; only our three names were saved.
  # shellcheck disable=SC1090
  source "$state_file"
  assignments=()
  present=()
  absent=()
  for name in "${variables[@]}"; do
    assignments+=("$name=${!name-}")
    if [[ -v $name ]]; then
      present+=("$name=${!name}")
    else
      absent+=("$name")
    fi
  done
  if (( ${#present[@]} )); then
    systemctl --user set-environment "${present[@]}"
  fi
  if (( ${#absent[@]} )); then
    systemctl --user unset-environment "${absent[@]}"
  fi
  # D-Bus cannot unset variables; empty clears them without re-setting systemd.
  if ! dbus-update-activation-environment "${assignments[@]}"; then
    echo "Could not restore D-Bus activation environment; systemd was restored." >&2
  fi
  rm -- "$state_file"
)

case "${1:-}" in
  start)
    umask 077
    mkdir -p -- "$state_dir"
    # Recover a snapshot retained by an interrupted or failed cleanup.
    restore_environment
    previous=$(systemctl --user show-environment)
    snapshot=$(mktemp "$state_dir/environment.XXXXXXXX")
    trap 'rm -f -- "$snapshot"' EXIT
    while IFS= read -r assignment; do
      case "${assignment%%=*}" in
        QT_QPA_PLATFORMTHEME|QT_QPA_PLATFORMTHEME_QT6|XDG_MENU_PREFIX)
          printf '%s\n' "$assignment" >> "$snapshot"
          ;;
      esac
    done <<< "$previous"
    mv -- "$snapshot" "$state_file"

    assignments=()
    for name in "${variables[@]}"; do
      if [[ -v $name ]]; then
        assignments+=("$name=${!name}")
      fi
    done
    dbus-update-activation-environment --systemd "${assignments[@]}"
    ;;
  stop)
    restore_environment
    ;;
  *)
    echo "Usage: dux-niri-environment start|stop" >&2
    exit 2
    ;;
esac
